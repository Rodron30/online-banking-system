{
  "extends": [
    "development"
  ],
  "hints": {
    "no-inline-styles": "off",
    "axe/language": [
      "default",
      {
        "html-has-lang": "off"
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "min-height: auto",
          "backdrop-filter",
          "-webkit-overflow-scrolling",
          "mask-image"
        ]
      }
    ],
    "css-prefix-order": "off"
  }
}